# Base image with Node.js (suitable for React dev server)
FROM node:18

# Set working directory inside the container
WORKDIR /usr/src/app

# Copy dependency definition files first (for better layer caching)
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the React application source code
COPY . .

# Prevent browser from auto-opening
ENV BROWSER=none

# Expose React development server port
EXPOSE 3000

# Start React development server
CMD ["npm", "start"]
